{
  "name": "mossa-browser",
  "version": "2.0.0-preview.4",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "wasm": "wasm-pack build rust-core --target web --out-dir ../src/wasm --release",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run wasm && npm run build:web",
    "build:web": "tsc -b && vite build",
    "test": "npm run wasm && cargo test --manifest-path rust-core/Cargo.toml && node --test tests/*.test.mjs && tsx --test tests/*.test.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "wasm-pack": "^0.15.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
