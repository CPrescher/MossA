{
  "name": "mossa-browser",
  "version": "2.0.0-preview.17",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "wasm": "wasm-pack build rust-core --target web --out-dir ../src/wasm --release",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run wasm && npm run build:web",
    "build:web": "tsc -b && vite build",
    "dev:manual": "npm --prefix manual run dev",
    "build:manual": "npm --prefix manual run build",
    "build:pages": "npm run build:web && npm run build:manual && node scripts/assemble-pages.mjs",
    "test": "npm run wasm && cargo test --manifest-path rust-core/Cargo.toml && node --test tests/*.test.mjs && tsx --test tests/*.test.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node scripts/serve.mjs",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "dev:desktop:web": "node scripts/build-desktop.mjs --dev",
    "build:desktop:web": "node scripts/build-desktop.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "test:native": "npm run wasm && node scripts/test-native.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@tauri-apps/api": "2.12.4",
    "jspdf": "^4.2.1",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.9.0",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^31.0.0",
    "sirv": "3.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "wasm-pack": "^0.15.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
